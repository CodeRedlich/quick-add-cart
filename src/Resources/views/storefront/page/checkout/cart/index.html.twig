{% sw_extends "@Storefront/storefront/page/checkout/cart/index.html.twig" %}

{% block page_checkout_cart_add_product %}

    {% if context
        and context is instanceof('Shopware\\Core\\System\\SalesChannel\\SalesChannelContext')
        and quickAddIsEnabled(context)
        and config('QuickAddCart.config.showAdvancedSearchInOffCanvas') %}

        {% sw_include '@QuickAddCart/storefront/plugin/component/search/cr-search-field.html.twig' with {
            location: constant('CodeRedlich\\QuickAddCart\\Util\\PluginConstants::LOCATION_CHECKOUT_CART'),
            containerClass: 'col-md-5'
        }%}

    {% else %}
        {{ parent() }}
    {% endif %}

{% endblock %}