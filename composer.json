{
    "name": "code-redlich/quick-add-cart",
    "version": "0.0.3",
    "description": "Add Products via name or product number to cart in checkout or card modal.",
    "type": "shopware-platform-plugin",
    "require": {
        "php" : "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
        "shopware/core": "~6.7.0",
        "shopware/storefront": "~6.7.0"
    },
    "require-dev": {
        "shopware/dev-tools": "^1.5.1"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "CodeRedlich\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CodeRedlich\\Tests\\": "tests/unit"
        }
    },
    "authors": [
        {
            "name": "CodeRedlich",
            "email": "support@code-redlich.com"
        }
    ],
    "config": {
        "allow-plugins": {
            "symfony/runtime": true,
            "php-http/discovery": true
        }
    },
    "extra": {
        "shopware-plugin-class": "CodeRedlich\\QuickAddCart",
        "label": {
            "de-DE": "Schnell zum Warenkorb hinzufügen",
            "en-GB": "Quick add to cart"
        },
        "description": {
            "de-DE": "Füge Produkte per Artikelnummer oder Name direkt zum Shopware-Warenkorb hinzu. Die Suche ist im Warenkorb und im Offcanvas verfügbar und lässt sich per Regel steuern.",
            "en-GB": "Add products to your Shopware cart by product number or name. The search is available on the cart page and in the off-canvas cart, and can be controlled by a rule."
        },
        "manufacturer": {
            "de-DE": "Code Redlich",
            "en-GB": "Code Redlich"
        },
        "manufacturerLink": {
            "de-DE": "https://github.com/CodeRedlich",
            "en-GB": "https://github.com/CodeRedlich"
        },
        "supportLink": {
            "de-DE": "https://github.com/CodeRedlich/quick-add-cart",
            "en-GB": "https://github.com/CodeRedlich/quick-add-cart"
        }
    }
}
